# Reference baseline only. Not approved for order submission.
EXECUTION_MODE=disabled
ENABLE_ORDER_SUBMISSION=false
VALIDATION_PASSED=false
LIVE_TRADING=false
BOT_SYMBOLS=EURUSD,GBPUSD,USDJPY,AUDUSD,USDCAD,USDCHF,XAUUSD
# Keep every market in research; do not grant execution eligibility without evidence.
BOT_QUALIFIED_SYMBOLS=
RISK_PROFILE=micro_aggressive
# Structural stop-risk ceiling; a setup that cannot fit minimum lots is skipped.
# This is NOT a daily-loss or losing-streak shutdown.
MAX_STOP_RISK_PCT=0.05
POLL_SECONDS=15
